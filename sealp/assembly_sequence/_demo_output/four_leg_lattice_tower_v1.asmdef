- step: 7
  part: mast
  parent: top_deck
  rel_pos:
  - !!float '0'
  - !!float '0'
  - 0.004
  rel_rotmat:
  - - !!float '1'
    - !!float '0'
    - !!float '0'
  - - !!float '0'
    - !!float '1'
    - !!float '0'
  - - !!float '0'
    - !!float '0'
    - !!float '1'
  deps:
  - 6
  insertion_axis:
  - !!float '0'
  - !!float '0'
  - !!float '-1'
